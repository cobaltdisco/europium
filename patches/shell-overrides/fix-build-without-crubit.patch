# Override of ungoogled-chromium-macos/patches/ungoogled-chromium/macos/fix-build-without-crubit.patch,
# rebased for Chromium 156.0.8078.47 (upstream shell still targets 155 as of 2026-10-23).
# WHY: 156 split components/cbor/BUILD.gn into cbor_headers / cbor_rust_impl / cbor, and the Rust
# deps of the second site moved into cbor_rust_impl as `deps +=`, so the old context no longer
# matched. Same `!is_cronet_build` -> `enable_cpp_api_from_rust` substitution at all three sites.
# On Google's toolchain enable_cpp_api_from_rust is true, so this patch changes nothing for us;
# keep it only so the kept-patch set stays upstream's. Deliberately NOT upstream's 154 version,
# which reverts Rust to C++ unconditionally (D18).
# base-sha256: c7e375f04941b33bc5c9cf03b7b6bf86dad9a2f9b5f6d012d45a1bd6dc3a49fa
#   (SHA-256 of the upstream shell copy this override replaces; install-custom-patches.sh refuses to
#   install over any other content, so an upstream change to this patch forces a re-review.)
# DROP this file once the upstream shell ships an equivalent rebase.
--- a/components/cbor/BUILD.gn
+++ b/components/cbor/BUILD.gn
@@ -12,7 +12,7 @@ buildflag_header("buildflags") {
   # TODO(crbug.com/535682335): Remove `USE_CBOR_RUST` buildflag entirely,
   # unconditionally enable Rust CBOR parser, and drop `is_cronet_build` check
   # once Cronet supports Crubit dependencies.
-  flags = [ "USE_CBOR_RUST=!$is_cronet_build" ]
+  flags = [ "USE_CBOR_RUST=$enable_cpp_api_from_rust" ]
 }
 
 source_set("cbor_headers") {
@@ -48,7 +48,7 @@ source_set("cbor_rust_impl") {
     "//base",
   ]
 
-  if (!is_cronet_build) {
+  if (enable_cpp_api_from_rust) {
     deps += [
       "//build/rust/crubit",
       "//components/cbor/rust:cbor_rust_bindings",
@@ -91,7 +91,7 @@ source_set("unit_tests") {
     "//testing/gtest",
     "//third_party/fuzztest",
   ]
-  if (!is_cronet_build) {
+  if (enable_cpp_api_from_rust) {
     deps += [
       "//components/cbor/rust:cbor_rust_bindings",
       "//components/cbor/rust:cbor_rust_unittests",
