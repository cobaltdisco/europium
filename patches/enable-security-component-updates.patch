+
+#ifndef COMPONENTS_UPDATE_CLIENT_EUROPIUM_ALLOWED_COMPONENTS_H_
+#define COMPONENTS_UPDATE_CLIENT_EUROPIUM_ALLOWED_COMPONENTS_H_
+
+#include <algorithm>
+#include <array>
+#include <string_view>
+
+namespace update_client {
+
+// The only components Europium fetches from Google's component update
+// service. ungoogled-chromium turns component updates off entirely; that also
+// cuts off emergency certificate revocations and keeps the CT log list from
+// being refreshed, so these two are let back in. Everything else stays off.
+inline constexpr std::array<std::string_view, 2> kEuropiumAllowedComponents = {
+    "hfnkpimlhhgieaddgfemjhofmfblmnib",  // CRLSet: revoked certs and keys.
+    "efniojlnjndmcbiieegkicadnoecjjef",  // PKI Metadata: CT log list, Chrome
+                                         // Root Store, key pins.
+};
+
+inline bool IsEuropiumAllowedComponent(std::string_view app_id) {
+  return std::ranges::find(kEuropiumAllowedComponents, app_id) !=
+         kEuropiumAllowedComponents.end();
+}
+
+}  // namespace update_client
+
+#endif  // COMPONENTS_UPDATE_CLIENT_EUROPIUM_ALLOWED_COMPONENTS_H_
